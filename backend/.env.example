# Copiez ce fichier en .env (jamais commité) pour le lancement en local.
# Aucune clé API n'est nécessaire avec la voix Microsoft Edge.

# Fournisseur de voix : edge (voix réelles, gratuit) ou fake (silence, pour tester sans réseau)
TTS_PROVIDER=edge

# Taille maximale du texte (≈ 15 000 caractères ≈ 15 à 20 minutes de dictée)
MAX_TEXT_CHARS=15000

# Nombre de générations autorisées par heure et par adresse IP (0 = illimité)
RATE_LIMIT_PER_HOUR=20

# Nombre de segments envoyés en parallèle au service de voix
TTS_CONCURRENCY=4

# Durée maximale d'une génération, en secondes
GENERATION_TIMEOUT_SECONDS=240

# Origines autorisées (CORS), séparées par des virgules.
# Inutile si le site et l'API sont servis par le même serveur (cas de Render).
# À renseigner seulement si le frontend est hébergé ailleurs, ex. https://audiotraining.netlify.app
CORS_ORIGINS=

# Dossier du frontend compilé (par défaut : ../frontend/dist)
# FRONTEND_DIST=
